// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  COMPANY_ADMIN
  SALES_AGENT
  ACCOUNTANT
}

enum UnitStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum ReservationStatus {
  ACTIVE
  EXPIRED
  CONVERTED
}

enum ContractStatus {
  DRAFT
  APPROVED
  COMPLETED
}

enum InstallmentStatus {
  PENDING
  PARTIAL
  PAID
}

enum PaymentMethod {
  SADAD
  MADA
  BANK_TRANSFER
  CASH
  CHEQUE
}

model Company {
  id           String        @id @default(uuid())
  name         String
  crNumber     String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  users        User[]
  units        Unit[]
  clients      Client[]
  reservations Reservation[]
  contracts    Contract[]
  payments     Payment[]
  auditLogs    AuditLog[]

  @@map("companies")
}

model User {
  id                String        @id @default(uuid())
  companyId         String
  email             String        @unique
  passwordHash      String
  name              String
  role              UserRole
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions          Session[]
  clients           Client[]      @relation("UserClients")
  reservations      Reservation[] @relation("UserReservations")
  contractsCreated  Contract[]    @relation("CreatedContracts")
  contractsApproved Contract[]    @relation("ApprovedContracts")
  payments          Payment[]     @relation("UserPayments")
  auditLogs         AuditLog[]

  @@unique([id, companyId])
  @@index([companyId])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid())
  sessionTokenHash String    @unique
  userId           String
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  revokedAt        DateTime?
  ipAddress        String?
  userAgent        String?

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionTokenHash])
  @@map("sessions")
}

model Unit {
  id           String        @id @default(uuid())
  companyId    String
  project      String
  code         String
  type         String
  floor        String
  area         Int
  rooms        Int
  price        Decimal       @db.Decimal(14, 2)
  status       UnitStatus    @default(AVAILABLE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  contracts    Contract[]

  @@unique([companyId, code])
  @@unique([id, companyId])
  @@index([companyId, status])
  @@map("units")
}

model Client {
  id          String        @id @default(uuid())
  companyId   String
  createdById String
  name        String
  phone       String
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User          @relation("UserClients", fields: [createdById, companyId], references: [id, companyId], onDelete: Restrict)
  reservations Reservation[]
  contracts   Contract[]

  @@unique([id, companyId])
  @@index([companyId, createdById])
  @@map("clients")
}

model Reservation {
  id          String            @id @default(uuid())
  companyId   String
  unitId      String
  clientId    String
  createdById String
  expiresAt   DateTime
  status      ReservationStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unit        Unit              @relation(fields: [unitId, companyId], references: [id, companyId], onDelete: Restrict)
  client      Client            @relation(fields: [clientId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy   User              @relation("UserReservations", fields: [createdById, companyId], references: [id, companyId], onDelete: Restrict)
  contracts   Contract[]

  @@unique([id, companyId])
  @@index([companyId, unitId, status])
  @@map("reservations")
}

model Contract {
  id                 String         @id @default(uuid())
  companyId          String
  contractNumber     String
  unitId             String
  clientId           String
  reservationId      String?
  createdById        String
  approvedById       String?
  approvedAt         DateTime?
  unitPrice          Decimal        @db.Decimal(14, 2)
  discountPercent    Decimal        @default(0) @db.Decimal(5, 2)
  finalPrice         Decimal        @db.Decimal(14, 2)
  downPayment        Decimal        @db.Decimal(14, 2)
  installmentCount   Int
  status             ContractStatus @default(DRAFT)
  startDate          DateTime
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  company            Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unit               Unit           @relation(fields: [unitId, companyId], references: [id, companyId], onDelete: Restrict)
  client             Client         @relation(fields: [clientId, companyId], references: [id, companyId], onDelete: Restrict)
  reservation        Reservation?   @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  createdBy          User           @relation("CreatedContracts", fields: [createdById, companyId], references: [id, companyId], onDelete: Restrict)
  approvedBy         User?          @relation("ApprovedContracts", fields: [approvedById, companyId], references: [id, companyId], onDelete: Restrict)
  installments       Installment[]
  payments           Payment[]

  @@unique([companyId, contractNumber])
  @@unique([id, companyId])
  @@index([companyId, status])
  @@map("contracts")
}

model Installment {
  id                String            @id @default(uuid())
  contractId        String
  installmentNumber Int
  dueDate           DateTime
  amount            Decimal           @db.Decimal(14, 2)
  paidAmount        Decimal           @default(0) @db.Decimal(14, 2)
  status            InstallmentStatus @default(PENDING)
  paidAt            DateTime?

  contract          Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  allocations       PaymentAllocation[]

  @@unique([contractId, installmentNumber])
  @@index([contractId, status])
  @@map("installments")
}

model Payment {
  id             String              @id @default(uuid())
  companyId      String
  contractId     String
  createdById    String
  receiptNumber  String
  amount         Decimal             @db.Decimal(14, 2)
  method         PaymentMethod
  idempotencyKey String              @unique
  notes          String?
  createdAt      DateTime            @default(now())

  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contract       Contract            @relation(fields: [contractId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy      User                @relation("UserPayments", fields: [createdById, companyId], references: [id, companyId], onDelete: Restrict)
  allocations    PaymentAllocation[]

  @@unique([companyId, receiptNumber])
  @@unique([id, companyId])
  @@index([companyId, contractId])
  @@map("payments")
}

model PaymentAllocation {
  id            String      @id @default(uuid())
  paymentId     String
  installmentId String
  amount        Decimal     @db.Decimal(14, 2)

  payment       Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  installment   Installment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([installmentId])
  @@map("payment_allocations")
}

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    String
  ipAddress  String?
  createdAt  DateTime @default(now())

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, action])
  @@index([companyId, createdAt])
  @@map("audit_logs")
}
