# =========================================================================
# Aqaar Lite (عقار لايت) - Environment Configuration Template
# =========================================================================

# Database Configuration (PostgreSQL 14+)
# Local native connection:
DATABASE_URL="postgresql://postgres@localhost:5432/aqar_lite?schema=public"

# For Docker Compose environment:
# DATABASE_URL="postgresql://aqar_user:aqar_secure_pass_2026@db:5432/aqar_lite_db?schema=public"

# Application Settings
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"

# Session & Security Settings
# Raw session tokens are generated with 256 bits of cryptographically secure random entropy
# and stored in PostgreSQL as SHA-256 hashes.
SESSION_DURATION_DAYS=7
